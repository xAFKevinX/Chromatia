#!/usr/bin/env python3
"""chromatia-sync – keeps the whole desktop in the colors of the current wallpaper.

Called by the wallpaper panel (``--set PATH``) or by a systemd path unit whenever the
Plasma desktop config changes. For every screen it:
  * remembers the chosen wallpaper (image or video),
  * picks a strong accent color from it (for videos: from a still frame),
  * writes the accent into all Chromatia widgets, the Panel Colorizer settings and the
    Chromatia wallpaper plugin (which draws the frame and the visualizer),
  * optionally sets it as the KDE system accent color (folders, highlights, apps).

Wallpapers using the stock "org.kde.image" plugin get the frame baked into a copy of
the image instead, so the look also works without the Chromatia wallpaper plugin.

Config (optional): ~/.config/chromatia/chromatia.conf
    [General]
    SystemAccent=true     # false: never touch the KDE system accent color
"""
import colorsys
import configparser
import hashlib
import json
import os
import subprocess
import sys
import time

from PIL import Image, ImageDraw

HOME = os.path.expanduser("~")
APPLETSRC = os.path.join(HOME, ".config/plasma-org.kde.plasma.desktop-appletsrc")
KDEGLOBALS = os.path.join(HOME, ".config/kdeglobals")
CONFIG = os.path.join(HOME, ".config/chromatia/chromatia.conf")
OUTDIR = os.path.join(HOME, ".local/share/chromatia/framed")      # framed copies for org.kde.image
STATE = os.path.join(HOME, ".local/state/chromatia/state.json")
THUMBS = os.path.join(HOME, ".cache/chromatia/thumbs")

FRAME = 10        # frame width in logical pixels (panels on an edge make it wider)
RADIUS = 25       # radius of the inner corners
SAT, LIGHT = 0.25, 0.075                       # frame / bar color derived from the accent
OWN = "chromatia.wallpaper"                    # draws the frame itself (also over videos)
PLUGINS = ("org.kde.image", OWN)
VIDEO_EXT = (".mp4", ".webm", ".mkv", ".mov", ".m4v")
IMAGE_EXT = (".png", ".jpg", ".jpeg", ".webp", ".avif", ".bmp")


def log(msg):
    print(msg, flush=True)


def read_ini(path):
    cp = configparser.RawConfigParser(strict=False)
    cp.optionxform = str
    cp.read(path, encoding="utf-8")
    return cp


def setting(key, default):
    return read_ini(CONFIG).get("General", key, fallback=default)


def pictures_dir():
    try:
        out = subprocess.run(["xdg-user-dir", "PICTURES"], capture_output=True, text=True, timeout=5).stdout.strip()
        if out and out != HOME:
            return out
    except Exception:
        pass
    return os.path.join(HOME, "Pictures")


def is_video(path):
    return str(path).lower().endswith(VIDEO_EXT)


def still_of(path):
    """Still frame of a video (for colors and previews), cached."""
    if not is_video(path):
        return path
    os.makedirs(THUMBS, exist_ok=True)
    out = os.path.join(THUMBS, os.path.basename(path) + ".still.png")
    if not (os.path.exists(out) and os.path.getmtime(out) >= os.path.getmtime(path)):
        subprocess.run(["gst-launch-1.0", "-q", "filesrc", f"location={path}", "!", "decodebin", "!",
                        "videoconvert", "!", "videoscale", "!", "video/x-raw,width=1280", "!",
                        "pngenc", "snapshot=true", "!", "filesink", f"location={out}"],
                       capture_output=True, timeout=60)
    return out if os.path.exists(out) else None


def accent():
    raw = read_ini(KDEGLOBALS).get("General", "AccentColor", fallback="61,174,233")
    r, g, b = [int(x) for x in raw.split(",")[:3]]
    return r, g, b


def pick_accent(path):
    """A strong, clearly visible color from the image."""
    im = Image.open(path).convert("RGB").resize((96, 54))
    pal = im.quantize(colors=12, method=Image.Quantize.MEDIANCUT)
    colors = pal.convert("RGB").getcolors(96 * 54) or []
    best, score = (61, 174, 233), -1
    for count, (r, g, b) in colors:
        h, l, s = colorsys.rgb_to_hls(r / 255, g / 255, b / 255)
        if l < 0.18 or l > 0.85:
            continue
        sc = (s ** 1.5) * (count ** 0.5) * (1 - abs(l - 0.5))
        if sc > score:
            best, score = (r, g, b), sc
    h, l, s = colorsys.rgb_to_hls(*(c / 255 for c in best))
    r, g, b = colorsys.hls_to_rgb(h, min(max(l, 0.45), 0.62), max(s, 0.35))
    return round(r * 255), round(g * 255), round(b * 255)


def apply_system_accent(rgb):
    """Set the KDE system accent color (folders, highlights, apps)."""
    if setting("SystemAccent", "true").lower() in ("false", "0", "no"):
        return
    cur = read_ini(KDEGLOBALS).get("Colors:View", "DecorationFocus", fallback="")
    val = ",".join(str(c) for c in rgb)
    if cur.replace(" ", "") == val:
        return
    subprocess.run(["plasma-apply-colorscheme", "-a", "#%02x%02x%02x" % rgb], capture_output=True, timeout=30)
    log(f"system accent {val}")
    # Tinted Breeze folder icons still use the old color after plasma-apply-colorscheme's own
    # signal. One extra "palette changed" a moment later fixes that (only one: each costs a redraw).
    time.sleep(0.3)
    subprocess.run(["dbus-send", "--session", "--type=signal", "/KGlobalSettings",
                    "org.kde.KGlobalSettings.notifyChange", "int32:0", "int32:0"],
                   capture_output=True, timeout=10)


def frame_color(rgb):
    h, _l, _s = colorsys.rgb_to_hls(*(c / 255 for c in rgb))
    r, g, b = colorsys.hls_to_rgb(h, LIGHT, SAT)
    return round(r * 255), round(g * 255), round(b * 255)


def colors_script(acc, wall=""):
    """Plasma script: write the colors into all Chromatia widgets, Panel Colorizer and the
    wallpaper plugin. Only writes what changed (otherwise the path unit would loop)."""
    h, _l, _s = colorsys.rgb_to_hls(*(c / 255 for c in acc))

    def hsl(sat, light):
        r, g, b = colorsys.hls_to_rgb(h, light, sat)
        return "#%02x%02x%02x" % (round(r * 255), round(g * 255), round(b * 255))
    accent_hex = "#%02x%02x%02x" % acc
    cols = {"panelBg": hsl(0.25, 0.075), "widgetBg": hsl(0.20, 0.17), "fg": hsl(0.55, 0.85)}
    return ("var ACC=%s, C=%s, WALL=%s, n=0;" % (json.dumps(accent_hex), json.dumps(cols), json.dumps(wall)) + """
function setc(o, hex){ if(!o) return; o.enabled=true; o.sourceType=0; o.custom=hex; o.alpha=1;
  o.lightnessEnabled=false; o.saturationEnabled=false; }
panels().forEach(function(p){ p.widgets().forEach(function(w){
  w.currentConfigGroup=["General"];
  if (w.type.indexOf("chromatia.")==0) {
    if (w.readConfig("accentColor")!=ACC){ w.writeConfig("accentColor",ACC); n++; }
    if (WALL && w.type=="chromatia.workspaces" && w.readConfig("wallpaper")!=WALL){ w.writeConfig("wallpaper",WALL); n++; }
  } else if (w.type=="luisbocanegra.panel.colorizer") {
    var g; try { g=JSON.parse(w.readConfig("globalSettings")); } catch(e) { return; }
    var before=JSON.stringify(g);
    setc(g.panel.normal.backgroundColor, C.panelBg);
    if (g.widgets.normal.enabled) setc(g.widgets.normal.backgroundColor, C.widgetBg);
    setc(g.widgets.normal.foregroundColor, C.fg);
    if (g.trayWidgets && g.trayWidgets.normal) setc(g.trayWidgets.normal.foregroundColor, C.fg);
    var after=JSON.stringify(g);
    if (after!=before){ w.writeConfig("globalSettings", after); n++; }
  }
});});
desktops().forEach(function(d){
  d.currentConfigGroup=["General"];
  d.widgets().forEach(function(w){ if (w.type.indexOf("chromatia.")==0) { w.currentConfigGroup=["General"];
    if (w.readConfig("accentColor")!=ACC){ w.writeConfig("accentColor",ACC); n++; } } });
  if (d.wallpaperPlugin!="%s") return;
  d.currentConfigGroup=["Wallpaper","%s","General"];
  if (d.readConfig("AccentColor")!=ACC){ d.writeConfig("AccentColor",ACC); n++; } });
if (n>0) print("colors updated: "+n);
""" % (OWN, OWN))


def plasma_eval(script):
    return subprocess.run(["qdbus-qt6", "org.kde.plasmashell", "/PlasmaShell",
                           "org.kde.PlasmaShell.evaluateScript", script],
                          capture_output=True, text=True, timeout=20).stdout.strip()


def screens():
    """screen index -> logical size, scale and panel thickness per edge."""
    info = json.loads(plasma_eval(
        'var r={};'
        'for (var i=0;i<screenCount;i++){var g=screenGeometry(i);r[i]={w:g.width,h:g.height,x:g.x,y:g.y,bottom:0,top:0,left:0,right:0};}'
        'panels().forEach(function(p){if(!r[p.screen]||p.hiding!="none")return;var e=p.location;'
        'if(e=="bottom"||e=="top"||e=="left"||e=="right")r[p.screen][e]=Math.max(r[p.screen][e],p.height);});'
        'print(JSON.stringify(r));') or "{}")
    try:
        ks = json.loads(subprocess.run(["kscreen-doctor", "-j"], capture_output=True, text=True, timeout=20).stdout)
        outs = [o for o in ks.get("outputs", []) if o.get("enabled")]
    except Exception:
        outs = []
    for s in info.values():
        s["scale"] = 1.0
        for o in outs:
            pos = o.get("pos", {})
            if pos.get("x") == s["x"] and pos.get("y") == s["y"]:
                s["scale"] = float(o.get("scale", 1.0))
    return {int(k): v for k, v in info.items()}


def desktop_wallpapers():
    """screen index -> (containment id, current image path, wallpaper plugin)."""
    cp = read_ini(APPLETSRC)
    result = {}
    for sec in cp.sections():
        parts = sec.split("][")
        if len(parts) != 2 or parts[0] != "Containments":
            continue
        cid = parts[1]
        if cp.get(sec, "plugin", fallback="") != "org.kde.plasma.folder":
            continue
        screen = cp.get(sec, "lastScreen", fallback=None)
        if screen is None:
            continue
        plugin = cp.get(sec, "wallpaperplugin", fallback="org.kde.image")
        if plugin not in PLUGINS:
            continue
        img = cp.get(f"Containments][{cid}][Wallpaper][{plugin}][General", "Image", fallback="")
        result[int(screen)] = (cid, img.replace("file://", ""), plugin)
    return result


def make_framed(src, out, screen, color):
    """Bake the frame into a copy of the image (for the stock image plugin)."""
    W = round(screen["w"] * screen["scale"])
    H = round(screen["h"] * screen["scale"])
    s = W / screen["w"]
    r = round(RADIUS * s)
    bottom = round(max(FRAME, screen["bottom"]) * s)
    top = round(max(FRAME, screen.get("top", 0)) * s)
    left = round(max(FRAME, screen.get("left", 0)) * s)
    right = round(max(FRAME, screen.get("right", 0)) * s)
    img = Image.open(src).convert("RGB")
    k = max(W / img.width, H / img.height)                    # "scaled and cropped"
    img = img.resize((max(W, round(img.width * k)), max(H, round(img.height * k))), Image.LANCZOS)
    cx, cy = (img.width - W) // 2, (img.height - H) // 2
    img = img.crop((cx, cy, cx + W, cy + H))
    ss = 4
    mask = Image.new("L", (W * ss, H * ss), 0)
    ImageDraw.Draw(mask).rounded_rectangle(
        [left * ss, top * ss, (W - right) * ss - 1, (H - bottom) * ss - 1], radius=r * ss, fill=255)
    mask = mask.resize((W, H), Image.LANCZOS)
    canvas = Image.new("RGB", (W, H), color)
    canvas.paste(img, (0, 0), mask)
    canvas.save(out)


def fingerprint(walls):
    return json.dumps(sorted((str(k), v[2], v[1] or "") for k, v in walls.items()))


def main():
    direct = sys.argv[2] if len(sys.argv) > 2 and sys.argv[1] == "--set" else None
    if not direct:
        time.sleep(2)                                    # let Plasma finish writing its config
    os.makedirs(OUTDIR, exist_ok=True)
    os.makedirs(os.path.dirname(STATE), exist_ok=True)
    try:
        state = json.load(open(STATE))
    except Exception:
        state = {}
    walls = desktop_wallpapers()
    # Plasma rewrites its config for many reasons. If the wallpapers did not change, do
    # nothing at all: every evaluateScript call blocks Plasma for a moment (visible hitch).
    if not direct and state.get("fingerprint") == fingerprint(walls):
        return
    if direct:
        for idx in walls:
            state[str(idx)] = direct
    else:
        for idx, (cid, current, plugin) in walls.items():
            if current and os.path.dirname(current) != OUTDIR and os.path.exists(current):
                state[str(idx)] = current
    main_original = state.get("0") or next(iter(state.values()), None)
    still = still_of(main_original) if main_original and os.path.exists(main_original) else None
    acc = pick_accent(still) if still and os.path.exists(still) else accent()
    state["accent"] = "#%02x%02x%02x" % acc
    color = frame_color(acc)
    hexcol = "%02x%02x%02x" % color
    scr = screens()
    changes, framed, own = {}, {}, {}
    for idx, (cid, current, plugin) in walls.items():
        if idx not in scr or (not current and plugin != OWN):
            continue
        original = state.get(str(idx)) or state.get("0")
        if not original or not os.path.exists(original):
            continue
        if plugin == OWN:
            sc = scr[idx]
            own[cid] = {"Image": "file://" + original,
                        "FrameTop": max(FRAME, sc.get("top", 0)), "FrameBottom": max(FRAME, sc["bottom"]),
                        "FrameLeft": max(FRAME, sc.get("left", 0)), "FrameRight": max(FRAME, sc.get("right", 0)),
                        "FrameRadius": RADIUS}
            framed[idx] = still_of(original) or ""
            continue
        if is_video(original):
            original = still_of(original)
            if not original:
                continue
        tag = hashlib.sha1(f"{original}|{scr[idx]}|{FRAME}|{RADIUS}|v2".encode()).hexdigest()[:8]
        target = os.path.join(OUTDIR, f"screen{idx}-{tag}-{hexcol}.png")
        framed[idx] = target
        if current == target:
            continue
        if not os.path.exists(target):
            make_framed(original, target, scr[idx], color)
            log(f"screen {idx}: frame {hexcol} for {os.path.basename(original)}")
        changes[cid] = (target, plugin)
        for f in os.listdir(OUTDIR):                     # remove older framed copies of this screen
            if f.startswith(f"screen{idx}-") and os.path.join(OUTDIR, f) != target:
                os.remove(os.path.join(OUTDIR, f))
    json.dump(state, open(STATE, "w"), indent=1)
    script = "".join(
        f'var d=desktopById({cid});d.currentConfigGroup=["Wallpaper","{plugin}","General"];'
        f'd.writeConfig("Image","file://{path}");'
        for cid, (path, plugin) in changes.items())
    for cid, vals in own.items():
        script += f'var d=desktopById({cid});d.currentConfigGroup=["Wallpaper","{OWN}","General"];var V={json.dumps(vals)};'
        script += 'for (var k in V){ if (String(d.readConfig(k))!=String(V[k])) d.writeConfig(k,V[k]); }'
    # Order matters for a hitch-free switch:
    # 1. set the wallpaper: the plugin freezes the old video and loads the new one invisibly
    # 2. recolor everything: Plasma stutters briefly, but nothing is moving right now
    # 3. write SwitchGo: only now the plugin crossfades and starts the new video
    if script:
        out = plasma_eval(script)
        if out:
            log(out)
    apply_system_accent(acc)
    go = "".join(
        f'var d=desktopById({cid});d.currentConfigGroup=["Wallpaper","{OWN}","General"];'
        f'd.writeConfig("SwitchGo",{json.dumps(vals["Image"])});'
        for cid, vals in own.items())
    out = plasma_eval(colors_script(acc, framed.get(0, "")) + go)
    if out:
        log(out)
    # remember what we just wrote (our own writes trigger the path unit again)
    expect = {}
    for idx, (cid, current, plugin) in walls.items():
        if cid in own:
            current = own[cid]["Image"].replace("file://", "")
        elif cid in changes:
            current = changes[cid][0]
        expect[idx] = (cid, current, plugin)
    state["fingerprint"] = fingerprint(expect)
    json.dump(state, open(STATE, "w"), indent=1)


def make_thumbs(gallery):
    """Small previews (360x200) for the wallpaper panel, only when new or changed."""
    os.makedirs(THUMBS, exist_ok=True)
    if not os.path.isdir(gallery):
        os.makedirs(gallery, exist_ok=True)
    names = set()
    for f in sorted(os.listdir(gallery)):
        src = os.path.join(gallery, f)
        if not os.path.isfile(src) or not f.lower().endswith(IMAGE_EXT + VIDEO_EXT):
            continue
        dst = os.path.join(THUMBS, f + ".jpg")
        names.add(f + ".jpg")
        if is_video(src):
            names.add(f + ".still.png")
        if os.path.exists(dst) and os.path.getmtime(dst) >= os.path.getmtime(src):
            continue
        try:
            pic = still_of(src)
            if not pic:
                continue
            im = Image.open(pic).convert("RGB")
            im.thumbnail((720, 400))
            k = max(360 / im.width, 200 / im.height)
            im = im.resize((round(im.width * k), round(im.height * k)), Image.LANCZOS)
            x, y = (im.width - 360) // 2, (im.height - 200) // 2
            im.crop((x, y, x + 360, y + 200)).save(dst, quality=85)
        except Exception as e:
            log(f"preview failed: {f}: {e}")
    for f in os.listdir(THUMBS):                          # drop previews of deleted files
        if f not in names:
            os.remove(os.path.join(THUMBS, f))


if __name__ == "__main__":
    if len(sys.argv) > 1 and sys.argv[1] == "--thumbs":
        make_thumbs(sys.argv[2] if len(sys.argv) > 2 else os.path.join(pictures_dir(), "Wallpapers"))
        sys.exit(0)
    try:
        main()
    except Exception as e:                                # never end up in a restart loop
        log(f"error: {e}")
        sys.exit(0)
